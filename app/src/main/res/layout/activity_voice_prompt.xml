<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prompt_page_title"
            android:textColor="@color/on_surface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/prompt_page_desc"
            android:textColor="@color/on_surface_variant"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <CheckBox
                android:id="@+id/prompt_elapsed_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/prompt_elapsed_label"
                android:textColor="@color/on_surface"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/prompt_elapsed_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:hint="@string/prompt_minutes_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="2"
                android:text="@string/prompt_elapsed_default"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/disabled_text"
                android:textSize="17sp"
                tools:text="已完成 xx 分钟" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <CheckBox
                android:id="@+id/prompt_water_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/prompt_water_label"
                android:textColor="@color/on_surface"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/prompt_water_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="2"
                android:text="@string/prompt_water_default"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/disabled_text"
                android:textSize="17sp"
                tools:text="请补充水分" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <CheckBox
                android:id="@+id/prompt_cheer_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/prompt_cheer_label"
                android:textColor="@color/on_surface"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/prompt_cheer_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="2"
                android:text="@string/prompt_cheer_default"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/disabled_text"
                android:textSize="17sp"
                tools:text="坚持运动，加油" />
        </LinearLayout>

        <Button
            android:id="@+id/prompt_save_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_primary_button"
            android:text="@string/prompt_save"
            android:textColor="@color/on_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>