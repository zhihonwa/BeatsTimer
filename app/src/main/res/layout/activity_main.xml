<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/app_name"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="#111827" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/subtitle"
            android:textSize="14sp"
            android:textColor="#6B7280" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/label_interval"
                android:textSize="18sp"
                android:textColor="#374151" />

            <EditText
                android:id="@+id/interval_input"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:gravity="center"
                android:textSize="28sp"
                android:maxLength="3"
                android:hint="@string/default_interval"
                tools:text="5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/unit_minutes"
                android:textSize="18sp"
                android:textColor="#374151" />
        </LinearLayout>

        <TextView
            android:id="@+id/countdown_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:textSize="44sp"
            android:textStyle="bold"
            android:textColor="#2563EB"
            android:visibility="gone"
            tools:text="00:59" />

        <Button
            android:id="@+id/start_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="@string/start_reporting"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="32dp"
            android:background="#E5E7EB" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/pick_music_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pick_music"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/music_name_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/music_builtin_track"
                android:textSize="13sp"
                android:textColor="#6B7280" />

            <Button
                android:id="@+id/clear_music_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clear_music"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/label_volume"
                android:textSize="14sp"
                android:textColor="#374151" />

            <SeekBar
                android:id="@+id/music_volume_seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="60" />

            <TextView
                android:id="@+id/music_volume_label"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textSize="14sp"
                android:textColor="#374151"
                tools:text="60%" />
        </LinearLayout>

        <TextView
            android:id="@+id/stability_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="8dp"
            android:text="@string/stability_entry"
            android:textSize="13sp"
            android:textColor="#2563EB" />
    </LinearLayout>
</ScrollView>